<form method="post">

    @model CadPacienteViewModel

      @{
        var nomeUsuario = Context.Session.GetString("nomeUsuario"); 
    }

    <div class="text-center">
        <h4 class="display-4">Cadastro de Pacientes</h4><p></p>Usuário: @nomeUsuario
        <hr />

        <table>
            <tr>
                <td colspan='2' style='text-align:left'><span>Nome:</span></td>
                <td colspan='4'><input type="text" asp-for="novoPaciente.Nome" value="@Model.novoPaciente.Nome" style="width:300px" /></td>
            </tr>
            <tr>
                <td colspan='2'  style='text-align:left'><span>Sobrenome:</span></td>
                <td colspan='4'><input type="text" asp-for="novoPaciente.Sobrenome" value="@Model.novoPaciente.Sobrenome" style="width:300px" /></td>
            </tr>
            <tr>
                <td colspan='2'  style='text-align:left'><span>E-mail:</span></td>
                <td colspan='4'><input type="email" asp-for="novoPaciente.Email.emailLocal" value="@Model.novoPaciente.Email.emailLocal" style="width:300px" /></td>
            </tr >
            <tr>
                <td colspan='2'  style='text-align:left'><span>CPF:</span></td>
                <td colspan='4'><input type="text" asp-for="novoPaciente.Cpf.cpfLocal" value="@Model.novoPaciente.Cpf.cpfLocal" style="width:300px" /></td>
            </tr>            
            <tr>
                <td colspan='2'  style='text-align:left'><span>Peso:</span></td>
                <td  style='text-align:left'><input type="text" asp-for="novoPaciente.Imc.Peso" value="@Model.novoPaciente.Imc.Peso" style="width:100px" /></td>
                
                <td  style='text-align:left'><span>Altura:</span></td>
                <td  style='text-align:left'><input type="text" asp-for="novoPaciente.Imc.Altura" value="@Model.novoPaciente.Imc.Altura" style="width:100px" /></td>
            </tr>
            <tr>
                <td colspan="6" style="text-align:center">
            <input type="radio" asp-for="novoPaciente.Sexo" value="M" /> Masculino
            <input type="radio" asp-for="novoPaciente.Sexo" value="F" /> Feminino
            <input type="radio" asp-for="novoPaciente.Sexo" hidden='true' checked=true value="N" /> 
            </td>
            </tr>

             <tr>
                <td colspan="6" style="text-align:center">
                    <button type="submit"> @Model.tituloBotaoSalvar </button>&nbsp;&nbsp;
                    <button type="button" onclick="window.location='/Home/Index'"> Sair </button>
                </td>
            </tr>

        </table>

        <hr />
    </div>

</form>

