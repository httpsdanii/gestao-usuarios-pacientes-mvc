@using PrjIMV_MVC_CORE.Controllers
@using PrjIMV_MVC_CORE.Models.PessoaModel
@using PrjIMV_MVC_CORE.Models.UsuarioModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PrjIMV_MVC_CORE</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head> 

@{
    var idUsuario = Context.Session.GetString("idUsuario");
    List<Usuario> listaUsuarios = CadUserController.RecuperaLista();

    Usuario? Logado = CadUserController.Busca(listaUsuarios,idUsuario??"");
    if (Logado != null && Logado.logado() == "Nao")
    {
         Logado= null;
    }
}
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">              
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">                       
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Login" asp-action="Index">Login</a>
                        </li>
                        @if (Logado != null && Logado.Perfil.ok("CadUser"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="CadUser" asp-action="Index">Cadastro de Usuário</a>
                            </li>
                        }
                        @if (Logado != null && Logado.Perfil.ok("ManUser"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="ManUser" asp-action="Index">Manutenção de Usuário</a>
                            </li>
                        }
                        @if (Logado != null && Logado.Perfil.ok("CadPaciente"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="CadPaciente" asp-action="Index">Cadastro de Paciente</a>
                            </li>
                        }
                        @if (Logado != null && Logado.Perfil.ok("ManPaciente"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="ManPaciente" asp-action="Index">Manutencao de Paciente</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>


    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - PrjIMV_MVC_CORE - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
 
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    @if (TempData["ErrosModal"] != null)
    {
        <partial name="Erros" />
    }

    @if (TempData["AvisosModal"] != null)
    {
        <partial name="Avisos" />
    }

  
</body>
</html>
